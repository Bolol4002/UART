#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib64/ivl/system.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib64/ivl/v2005_math.vpi";
:vpi_module "/usr/lib64/ivl/va_math.vpi";
S_0x555d62581d10 .scope module, "baud_gen_tb" "baud_gen_tb" 2 3;
 .timescale -9 -12;
v0x555d625a8260_0 .net "baud_tick", 0 0, v0x555d625818a0_0;  1 drivers
v0x555d625a8300_0 .var "clk", 0 0;
v0x555d625a83d0_0 .var "rst", 0 0;
S_0x555d625955d0 .scope module, "dut" "baud_gen" 2 10, 3 1 0, S_0x555d62581d10;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 1 "baud_tick";
P_0x555d62595760 .param/l "CLKS_PER_BIT" 0 3 2, +C4<00000000000000000000000110110010>;
v0x555d625818a0_0 .var "baud_tick", 0 0;
v0x555d625a7fa0_0 .net "clk", 0 0, v0x555d625a8300_0;  1 drivers
v0x555d625a8060_0 .var "clk_count", 15 0;
v0x555d625a8120_0 .net "rst", 0 0, v0x555d625a83d0_0;  1 drivers
E_0x555d62592d50 .event posedge, v0x555d625a7fa0_0;
    .scope S_0x555d625955d0;
T_0 ;
    %wait E_0x555d62592d50;
    %load/vec4 v0x555d625a8120_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 16;
    %assign/vec4 v0x555d625a8060_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x555d625818a0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x555d625a8060_0;
    %pad/u 32;
    %cmpi/e 433, 0, 32;
    %jmp/0xz  T_0.2, 4;
    %pushi/vec4 0, 0, 16;
    %assign/vec4 v0x555d625a8060_0, 0;
    %pushi/vec4 1, 0, 1;
    %assign/vec4 v0x555d625818a0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x555d625a8060_0;
    %addi 1, 0, 16;
    %assign/vec4 v0x555d625a8060_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x555d625818a0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x555d62581d10;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x555d625a8300_0;
    %inv;
    %store/vec4 v0x555d625a8300_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x555d62581d10;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555d625a8300_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x555d625a83d0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555d625a83d0_0, 0, 1;
    %pushi/vec4 1000, 0, 32;
T_2.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_2.1, 5;
    %jmp/1 T_2.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x555d62592d50;
    %jmp T_2.0;
T_2.1 ;
    %pop/vec4 1;
    %vpi_call 2 25 "$display", "clk_count max value reached as expected" {0 0 0};
    %vpi_call 2 26 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x555d62581d10;
T_3 ;
    %vpi_call 2 30 "$dumpfile", "baud_gen_tb.vcd" {0 0 0};
    %vpi_call 2 31 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x555d62581d10 {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb/baud_gen_tb.v";
    "src/baud_gen.v";
